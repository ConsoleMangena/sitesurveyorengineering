# Logs
logs
*.log
npm-debug.log*

# Captured local tooling output (lint/build runs) — not source
/build.txt
/eslint-out.txt
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env files (never commit; CI generates frontend/.env from secrets)
.env
.env.*
!.env.example


# Supabase CLI (local link metadata & versions — regenerated by `supabase link` / `start`)
backend/supabase/.temp/

# Generated SQL bundle for Dashboard paste (see build-dashboard-bundle.sh)
backend/supabase/bundle_apply_in_dashboard.sql

# GDAL runtime bundle (auto-populated by scripts/bundle-gdal.mjs)
/backend/bundled-gdal/*
!/backend/bundled-gdal/.gitkeep

# Downloaded GDAL SDK (auto-populated by scripts/download-gdal.mjs)
/backend/gdal-sdk/


# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent / AI tooling configuration (local-only skills and context not source)
.agents/
skills-lock.json

# Cloned admin dashboard template (MIT-licensed reference/starter)
templates/admin-dashboard/
